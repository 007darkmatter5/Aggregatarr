@inject Aggregatarr.Web.Services.ThemePreference Themes
<!DOCTYPE html>
<html lang="en" data-theme="@Themes.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Aggregatarr</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@420;560;650&family=Outfit:wght@560;700&display=swap" rel="stylesheet" />
    <link href="/css/fonts.css" rel="stylesheet" />
    <link href="/css/app.css" rel="stylesheet" />
    <link href="/css/lcars.css" rel="stylesheet" />
</head>
<body class="auth-body">
    <div class="auth-frame">
        @RenderBody()
    </div>
</body>
</html>
